# ============================================================
# SellifyX config — copy file này thành ".env" và điền giá trị
# ============================================================

# --- BẮT BUỘC: OpenAI API key ---
# Lấy tại https://platform.openai.com/api-keys → "Create new secret key"
OPENAI_API_KEY=

# Chế độ giả lập (không gọi API, không tốn tiền). Để "false" khi chạy thật.
OPENAI_MOCK=false

# Model text (phân loại / Product DNA / strategy / concept / Vision QA)
OPENAI_TEXT_MODEL=gpt-4.1

# ============================================================
# TẠO ẢNH — tham số gọi OpenAI Images API (images/edits)
# ============================================================

# Model tạo ảnh: gpt-image-1 hoặc gpt-image-2 (tùy tài khoản bạn có)
OPENAI_IMAGE_MODEL=gpt-image-2

# Endpoint tạo ảnh (thường không cần đổi)
OPENAI_IMAGE_EDIT_ENDPOINT=https://api.openai.com/v1/images/edits

# Kích thước AI sinh: 1024x1024 | 1024x1536 (dọc) | 1536x1024 (ngang) | auto
OPENAI_IMAGE_SIZE=1024x1024

# Chất lượng sinh ảnh: low | medium | high | auto  (cao = nét & đắt hơn)
OPENAI_IMAGE_QUALITY=high

# Độ bám ảnh gốc: low | high  → "high" giữ ĐÚNG sản phẩm hơn (đỡ méo/sai chi tiết)
OPENAI_IMAGE_INPUT_FIDELITY=high

# Định dạng API trả về: png | jpeg | webp  (app vẫn xuất .jpg cuối)
OPENAI_IMAGE_OUTPUT_FORMAT=png

# Nền: opaque | transparent | auto  (chỉ đổi khi cần nền trong suốt)
# OPENAI_IMAGE_BACKGROUND=auto

# ============================================================
# ẢNH CUỐI — file giao cho người dùng (app tự resize bằng sharp)
# ============================================================
FINAL_IMAGE_SIZE=800
FINAL_IMAGE_JPEG_QUALITY=80

# ============================================================
# HIỆU NĂNG / QC / HỆ THỐNG
# ============================================================
# Số ảnh tạo song song (giảm còn 3 nếu bị lỗi 429 rate-limit)
SELLIFYX_IMAGE_CONCURRENCY=5
# Số lần tự tạo lại ảnh không đạt Vision QA
SELLIFYX_QA_RETRIES=1
# Bật lại phân loại theo danh mục (mặc định tắt = generic mode)
# SELLIFYX_CATEGORY_MODE=1
# Cổng web (mặc định 4000)
# PORT=4000

# Giới hạn AI
AI_TIMEOUT_MS=180000
AI_MAX_RETRIES=2
AI_MAX_IMAGES=8
AI_MAX_IMAGE_SIZE_MB=10
